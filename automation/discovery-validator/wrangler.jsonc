{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "rushdanrosdi-discovery-validator",
  "main": "src/entry.js",
  "compatibility_date": "2026-09-12",
  "observability": {
    "enabled": true
  },
  "vars": {
    "SITE_ORIGIN": "https://rushdanrosdi.com",
    "ROBOTS_URL": "https://rushdanrosdi.com/robots.txt",
    "SITEMAP_URL": "https://rushdanrosdi.com/sitemap-index.xml",
    "GSC_SITE_URL": "sc-domain:rushdanrosdi.com"
  },
  "d1_databases": [
    {
      "binding": "DISCOVERY_DB",
      "database_name": "rushdanrosdi-discovery",
      "database_id": "883722cf-fe99-46df-8935-768695301bb3",
      "migrations_dir": "migrations"
    }
  ]
}
