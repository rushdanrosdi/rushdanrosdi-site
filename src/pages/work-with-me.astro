---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
---
<BaseLayout title="Work With Me | Rushdan Rosdi" description="Work with Rushdan Rosdi on AI Search, GEO and B2B buyer-discovery diagnostics.">
  <section class="placeholder-page">
    <p class="eyebrow"><span class="signal-dot"></span>Work With Me</p>
    <h1>Focused engagements. <em>Clear evidence.</em></h1>
    <p class="lead">Engagement options are being formalised. Current work centres on private AI Buyer Discovery Risk Scans and specialist partner support.</p>
    <div class="placeholder-status"><span>Limited availability</span><p>Private discussions are open for B2B brands, Fractional CMOs and specialist agencies.</p></div>
  </section>
  <CTA title="Start with a specific question." text="Share the brand, category and buyer-discovery problem you want to understand." secondaryLabel="Partner Edition" secondaryHref="/partner/" />
</BaseLayout>
