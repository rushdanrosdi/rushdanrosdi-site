---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
---
<BaseLayout title="Case Studies | Rushdan Rosdi" description="Selected AI Search and B2B visibility case studies from Rushdan Rosdi.">
  <section class="placeholder-page">
    <p class="eyebrow"><span class="signal-dot"></span>Case Studies</p>
    <h1>Evidence from <em>real discovery questions.</em></h1>
    <p class="lead">Selected, carefully anonymised examples will show how AI visibility findings translate into positioning, content and authority decisions.</p>
    <div class="placeholder-status"><span>Coming later</span><p>Case studies are being prepared with client and partner confidentiality in mind.</p></div>
  </section>
  <CTA title="Have a suitable B2B use case?" text="Get in touch to discuss a focused AI Buyer Discovery Risk Scan." />
</BaseLayout>
