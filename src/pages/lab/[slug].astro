---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchFooter from '../../components/ResearchFooter.astro';
import { getReadingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const notes = await getCollection('lab', ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.data.canonicalSlug },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const canonicalPath = `/lab/${note.data.canonicalSlug}/`;
const readingTime = getReadingTime(note.body ?? '', note.data.readingTime);
---

<BaseLayout
  title={`${note.data.title} | Rushdan Rosdi`}
  description={note.data.description}
  {canonicalPath}
  type="article"
  publishedTime={note.data.pubDate}
  tags={note.data.tags}
>
  <article class="article-page">
    <a class="back-link" href="/lab/">← All Lab Notes</a>
    <header class="article-header">
      <p class="eyebrow"><span class="signal-dot"></span>Lab Note</p>
      <h1>{note.data.title}</h1>
      <p class="lead">{note.data.description}</p>
      <div class="article-meta">
        <time datetime={note.data.pubDate.toISOString()}>
          {note.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' })}
        </time>
        <span>{readingTime} min read</span>
        <a href="/about/" aria-label="About Rushdan">Rushdan Rosdi</a>
      </div>
      <ul class="article-tags" aria-label="Topics">
        {note.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>
    <div class="prose prose--article">
      <Content />

      <ResearchFooter
        researchStatus={note.data.researchStatus}
        releaseType={note.data.releaseType}
        pubDate={note.data.pubDate}
        supports={note.data.supports}
        frameworkStages={note.data.frameworkStages}
      />

      <aside class="article-cta">
        <p>If you want to understand how your brand appears inside AI-assisted buyer research, start with the <a href="/partner/">AI Buyer Discovery Risk Scan</a>.</p>
      </aside>
      <a class="back-link article-back-link" href="/lab/">Return to Lab Notes</a>
    </div>
  </article>
</BaseLayout>
