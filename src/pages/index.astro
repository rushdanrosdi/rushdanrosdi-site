---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import CTA from '../components/CTA.astro';

const title = 'Rushdan Rosdi — AI Search & Visibility Specialist';
const description = 'Rushdan Rosdi helps B2B marketing leaders understand how their brands appear across ChatGPT, Gemini, Perplexity and Google AI surfaces.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Rushdan Rosdi',
  url: 'https://rushdanrosdi.com/',
  jobTitle: 'AI Search & Visibility Specialist',
  description,
  sameAs: ['https://coe.my/'],
};
---

<BaseLayout {title} {description} {schema}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="signal-dot"></span>AI Search & Visibility Specialist</p>
      <h1>Understand how AI <em>finds, frames and recommends</em> your brand.</h1>
      <p class="lead">I help B2B marketing leaders see how their brand appears across AI-assisted buyer research — then turn the evidence into focused action.</p>
      <div class="button-row">
        <a class="button button--primary" href="mailto:rushdan@rushdanrosdi.com">Discuss a project <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/partner/">Explore partner work <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <aside class="signal-panel" aria-label="AI visibility diagnostic">
      <div class="panel-topline"><span>AI visibility diagnostic</span><span class="status">Live focus</span></div>
      <div class="signal-visual" aria-hidden="true">
        <span class="orbit orbit--one"></span>
        <span class="orbit orbit--two"></span>
        <span class="orbit orbit--three"></span>
        <span class="core">BRAND</span>
        <span class="node node--one">AI answers</span>
        <span class="node node--two">Sources</span>
        <span class="node node--three">Buyers</span>
      </div>
      <dl class="signal-stats">
        <div><dt>01</dt><dd>Inclusion</dd></div>
        <div><dt>02</dt><dd>Accuracy</dd></div>
        <div><dt>03</dt><dd>Authority</dd></div>
      </dl>
    </aside>
  </section>

  <div class="trust-line">
    <p>Focused on the AI surfaces shaping B2B discovery</p>
    <ul aria-label="AI platforms">
      <li>ChatGPT</li><li>Gemini</li><li>Perplexity</li><li>Google AI</li>
    </ul>
  </div>

  <Section
    id="focus"
    eyebrow="Who this is for"
    title="Built for complex B2B buying journeys."
    intro="The work is designed for teams and partners who need defensible evidence, not another visibility score."
  >
    <div class="card-grid">
      <article class="card">
        <span class="card-index">01</span>
        <h3>Fractional CMOs</h3>
        <p>Use AI visibility evidence to guide positioning, website, content and demand priorities.</p>
      </article>
      <article class="card">
        <span class="card-index">02</span>
        <h3>B2B SaaS & Tech</h3>
        <p>See whether your brand enters the consideration set when buyers ask AI systems for options.</p>
      </article>
      <article class="card">
        <span class="card-index">03</span>
        <h3>Agencies & Consultants</h3>
        <p>Add specialist AI discovery analysis without building an internal GEO function from scratch.</p>
      </article>
    </div>
  </Section>

  <Section
    id="scan"
    eyebrow="Current offer"
    title="AI Buyer Discovery Risk Scan"
    intro="A fixed-scope diagnostic for one brand, one commercial category and a focused set of real buyer questions."
  >
    <div class="scan-layout">
      <div class="scan-statement">
        <p class="large-quote">“Does the brand enter the AI-assisted consideration set — and if not, why?”</p>
        <a class="text-link" href="/partner/">View the partner edition <span aria-hidden="true">→</span></a>
      </div>
      <div class="feature-list">
        <article><span>01</span><div><h3>Observe</h3><p>Map brand, competitor and source patterns across relevant AI answers.</p></div></article>
        <article><span>02</span><div><h3>Diagnose</h3><p>Identify inclusion gaps, message risks and weak authority signals.</p></div></article>
        <article><span>03</span><div><h3>Prioritise</h3><p>Turn the findings into a practical 90-day opportunity map.</p></div></article>
      </div>
    </div>
  </Section>

  <CTA
    title="Make AI visibility a strategic input."
    text="For private partner discussions, visibility diagnostics or questions about AI-assisted B2B buyer discovery."
    secondaryLabel="Read Lab Notes"
    secondaryHref="/lab/"
  />
</BaseLayout>
