---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
---
<BaseLayout title="Frameworks | Rushdan Rosdi" description="Practical frameworks for AI Search, B2B discovery and brand visibility.">
  <section class="placeholder-page">
    <p class="eyebrow"><span class="signal-dot"></span>Frameworks</p>
    <h1>Practical models for <em>AI-era discovery.</em></h1>
    <p class="lead">This section will collect field-tested ways to assess inclusion, accuracy, authority and buyer relevance across AI-assisted research.</p>
    <div class="placeholder-status"><span>In development</span><p>First frameworks will be published after further field testing.</p></div>
  </section>
  <CTA title="Follow the work as it develops." text="Lab Notes document the observations that will shape these frameworks." primaryLabel="Read Lab Notes" primaryHref="/lab/" />
</BaseLayout>
