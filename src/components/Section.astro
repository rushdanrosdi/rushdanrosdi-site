---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  narrow?: boolean;
}

const { id, eyebrow, title, intro, narrow = false } = Astro.props;
---

<section id={id} class:list={['section', { 'section--narrow': narrow }]}>
  {(eyebrow || title || intro) && (
    <header class="section-heading">
      {eyebrow && <p class="kicker">{eyebrow}</p>}
      {title && <h2>{title}</h2>}
      {intro && <p class="section-intro">{intro}</p>}
    </header>
  )}
  <slot />
</section>
